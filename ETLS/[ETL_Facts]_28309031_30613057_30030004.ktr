  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>BDTransaccional</connection>
    <sql>SELECT 
    e.cod_evento AS id_evento,    
    e.cod_sede AS id_sede,        
    e.fecha_inicia AS fecha_evento,    
    
    -- 1. Cantidad de entradas vendidas
    (SELECT COUNT(*) 
     FROM public.ENTRADA en 
     WHERE en.cod_evento = e.cod_evento) AS cantidad_evento,
    
    -- 2. Cantidad estimada de visitantes
    SUM(es.cantidad_estimada) AS cantidad_estim_visitante,
    
    -- 3. Meta de ingreso (cantidad_estimada * precio)
    SUM(es.cantidad_estimada * es.precio) AS meta_ingreso

FROM public.EVENTO e
INNER JOIN public.EVENTO_ESTAND es ON e.cod_evento = es.cod_evento
GROUP BY e.cod_evento, e.cod_sede, e.fecha_inicia;</sql>
